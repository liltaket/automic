{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "types": ["node", "chrome"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["core", "extension", "simulator", "eval", "tests"]
}
